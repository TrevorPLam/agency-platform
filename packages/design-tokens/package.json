{
  "name": "@agency/design-tokens",
  "version": "1.0.0",
  "description": "Design tokens package using Style Dictionary v4 and W3C DTCG format",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node --experimental-strip-types scripts/build-clients.ts && node --experimental-strip-types sd.config.ts",
    "build:js": "tsup",
    "build:tokens": "node --experimental-strip-types scripts/build-clients.ts && node --experimental-strip-types sd.config.ts",
    "tokens:build": "node --experimental-strip-types scripts/build-clients.ts && node --experimental-strip-types sd.config.ts"
  },
  "dependencies": {
    "style-dictionary": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
