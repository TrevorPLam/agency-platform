{
  "name": "@agency/security",
  "version": "0.1.0",
  "description": "Supply chain security and SBOM utilities for Agency Platform",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm exec vitest run",
    "test:ci": "pnpm exec vitest run --reporter=dot",
    "test:coverage": "pnpm exec vitest run --coverage",
    "generate-sbom": "tsx scripts/generate-sbom.ts",
    "verify-sbom": "tsx scripts/verify-sbom.ts",
    "scan-dependencies": "tsx scripts/scan-dependencies.ts"
  },
  "dependencies": {
    "@agency/database": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@agency/eslint-config": "workspace:*",
    "@agency/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./header-validator": {
      "types": "./src/header-validator.ts",
      "import": "./src/header-validator.ts",
      "require": "./src/header-validator.ts"
    },
    "./csp-validator": {
      "types": "./src/csp-validator.ts",
      "import": "./src/csp-validator.ts",
      "require": "./src/csp-validator.ts"
    },
    "./monitoring": {
      "types": "./src/monitoring.ts",
      "import": "./src/monitoring.ts",
      "require": "./src/monitoring.ts"
    },
    "./sbom": {
      "types": "./dist/sbom.d.ts",
      "import": "./dist/sbom.js",
      "require": "./dist/sbom.cjs"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "import": "./dist/integrity.js",
      "require": "./dist/integrity.cjs"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js",
      "require": "./dist/provenance.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "security",
    "sbom",
    "supply-chain",
    "integrity",
    "provenance",
    "agency-platform"
  ],
  "author": "trevo",
  "license": "ISC"
}
