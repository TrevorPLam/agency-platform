{
  "name": "@agency/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts",
      "require": "./src/auth.ts"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "import": "./src/admin.ts",
      "require": "./src/admin.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "require": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.declaration.json",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:ci": "pnpm exec vitest run --reporter=dot",
    "test:coverage": "pnpm exec vitest run --coverage",
    "db:generate-types": "pnpm run db:generate-types:local",
    "db:generate-types:local": "npx supabase gen types typescript --local --schema public > src/types.ts",
    "db:generate-types:linked": "npx supabase gen types typescript --linked --schema public > src/types.ts",
    "db:types:check": "tsx ../../scripts/database/validate-types.ts check",
    "db:types:update": "tsx ../../scripts/database/validate-types.ts update",
    "db:types:validate": "tsx ../../scripts/database/validate-types.ts check || (echo 'WARNING: Database types may be stale. Run \"pnpm db:types:update\" to update.' && exit 0)"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "@supabase/ssr": "catalog:",
    "ioredis": "catalog:"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@agency/eslint-config": "workspace:*",
    "@agency/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
