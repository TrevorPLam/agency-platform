{
  "name": "@agency/analytics",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/client.mjs",
  "types": "./dist/client.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./client": {
      "import": "./src/client.ts",
      "types": "./src/client.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    },
    "./consent": {
      "import": "./src/consent.ts",
      "types": "./src/consent.ts"
    },
    "./consent-context": {
      "import": "./src/consent-context.tsx",
      "types": "./src/consent-context.tsx"
    },
    "./consent-banner": {
      "import": "./src/consent-banner.tsx",
      "types": "./src/consent-banner.tsx"
    }
  },
  "dependencies": {
    "posthog-js": "catalog:",
    "posthog-node": "catalog:",
    "react": "catalog:",
    "next": "catalog:"
  },
  "devDependencies": {
    "@agency/eslint-config": "workspace:*",
    "typescript": "catalog:",
    "tsup": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "pnpm dlx vitest run",
    "test:ci": "pnpm dlx vitest run --reporter=dot",
    "test:coverage": "pnpm dlx vitest run --coverage"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "client": "src/client.ts",
      "server": "src/server.ts",
      "consent": "src/consent.ts",
      "consent-context": "src/consent-context.tsx",
      "consent-banner": "src/consent-banner.tsx"
    },
    "format": "esm",
    "dts": true,
    "clean": true,
    "external": [
      "posthog-js",
      "posthog-node",
      "react",
      "react-dom",
      "@agency/security",
      "@agency/analytics"
    ]
  }
}
