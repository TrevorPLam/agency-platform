{
  "name": "@agency/analytics",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/client.mjs",
  "types": "./dist/client.d.mts",
  "exports": {
    ".": {
      "import": "./dist/client.mjs",
      "types": "./dist/client.d.mts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.mts"
    }
  },
  "dependencies": {
    "posthog-js": "catalog:",
    "posthog-node": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:ci": "pnpm exec vitest run --reporter=dot",
    "test:coverage": "pnpm exec vitest run --coverage"
  },
  "tsup": {
    "entry": {
      "client": "src/client.ts",
      "server": "src/server.ts"
    },
    "format": "esm",
    "dts": true,
    "clean": true,
    "external": [
      "posthog-js",
      "posthog-node"
    ]
  }
}
