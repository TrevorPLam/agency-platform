{
  "name": "@agency/booking",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./widget": {
      "types": "./src/widget/booking-widget.tsx",
      "import": "./src/widget/booking-widget.tsx",
      "require": "./src/widget/booking-widget.tsx"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "pnpm dlx vitest run",
    "test:ci": "pnpm dlx vitest run --reporter=dot",
    "test:coverage": "pnpm dlx vitest run --coverage"
  },
  "dependencies": {
    "@agency/ui": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agency/eslint-config": "workspace:*",
    "@agency/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
