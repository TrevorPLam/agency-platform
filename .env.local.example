# Agency Platform Environment Variables
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
#
# Multi-environment: Use a separate .env.local on each machine (PC, laptop, etc.).
# Values are not synced via git — use a password manager or team vault for secrets.

# =============================================================================
# TENANT CONFIGURATION
# =============================================================================

# Current tenant slug for development (prospective/client apps only)
# Used by middleware.ts to resolve the correct tenant. Example: riley-day-care
# agency-admin may use a different slug or none; firm has no tenant slug.
NEXT_PUBLIC_TENANT_SLUG=riley-day-care

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase Project URL (required)
# Production: https://your-project-ref.supabase.co (from project settings > API)
# Local: http://127.0.0.1:54321 (after running `npx supabase start`; see docs/SUPABASE_LOCAL.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (required)
# Public key - safe for browser usage
# Get this from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (server-only)
# Secret key - never expose to browser
# Used for admin operations like tenant resolution
# Get this from your Supabase project settings > API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================

# PostHog Project API Key (required)
# Get this from your PostHog project settings (used by @agency/analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-api-key

# PostHog API Host (optional)
# Defaults to https://app.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# STORAGE SECURITY CONFIGURATION
# =============================================================================

# Storage bucket name for file uploads
# Default: uploads
STORAGE_BUCKET_NAME=uploads

# Maximum file size (in bytes)
# Default: 52428800 (50MB)
MAX_FILE_SIZE=52428800

# File retention period (in days)
# Default: 365
FILE_RETENTION_DAYS=365

# Enable file quarantine for suspicious files
# Default: true
ENABLE_FILE_QUARANTINE=true

# =============================================================================
# VIRUS SCANNING CONFIGURATION
# =============================================================================

# Enable virus scanning for uploaded files
# Default: false (set to true in production)
VIRUS_SCANNING_ENABLED=false

# Virus scanning provider
# Options: virustotal, clamav, mock
# Default: mock (for development)
VIRUS_SCAN_PROVIDER=mock

# VirusTotal API Key (required for virustotal provider)
# Get this from https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# Virus scanning timeout (in milliseconds)
# Default: 30000 (30 seconds)
VIRUS_SCAN_TIMEOUT=30000

# Virus scanning retry attempts
# Default: 3
VIRUS_SCAN_RETRY_ATTEMPTS=3

# Virus scanning retry delay (in milliseconds)
# Default: 1000 (1 second)
VIRUS_SCAN_RETRY_DELAY=1000

# =============================================================================
# EMAIL (RESEND)
# =============================================================================

# Resend API Key (required for contact forms and Inngest emails)
# Get this from https://resend.com
RESEND_API_KEY=re_your-resend-api-key

# Inbox to receive contact form notifications
CONTACT_TO_EMAIL=you@example.com

# From address for sent emails (optional; defaults to onboarding@resend.dev for development)
FROM_EMAIL=Agency <onboarding@resend.dev>

# =============================================================================
# BACKGROUND JOBS
# =============================================================================

# Inngest Event Key (required)
# Get this from your Inngest dashboard
INNGEST_EVENT_KEY=your-inngest-event-key

# Inngest Signing Key (required)
# Used for webhook signature verification
INNGEST_SIGNING_KEY=your-inngest-signing-key

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated list of domains)
# Development: Include localhost ports for local testing
# Production: Replace with actual production domains only
# Examples: http://localhost:3000,https://agency.example.com,https://client.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# CORS allowed HTTP methods (comma-separated)
# Standard REST methods plus OPTIONS for preflight requests
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# CORS allowed headers (comma-separated)
# Headers that clients are allowed to send in cross-origin requests
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Request-ID,traceparent,sentry-trace

# CORS credentials support (true/false)
# Set to true to allow cookies and authentication headers in cross-origin requests
# WARNING: Cannot be true if using wildcard (*) origins
CORS_CREDENTIALS=true

# CORS preflight cache duration (seconds)
# How long browsers can cache preflight request results
# 86400 = 24 hours, adjust based on your CORS policy change frequency
CORS_MAX_AGE=86400

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Enable development mode debugging
# Set to "true" for additional logging in development
DEBUG=false

# Skip SSL verification (development only)
# Set to "true" if using local Supabase with self-signed certs
SKIP_SSL_VERIFY=false
