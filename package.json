{
  "name": "agency-platform",
  "version": "1.0.0",
  "description": "Multi-client marketing agency monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "tokens:build": "turbo run tokens:build",
    "scaffold": "tsx scripts/scaffold-client.ts",
    "db:generate-types": "npx supabase gen types typescript --local > packages/database/src/types.ts",
    "db:seed-user": "tsx scripts/create-test-user.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "version": "changeset version",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "monorepo",
    "agency",
    "nextjs",
    "turborepo",
    "pnpm"
  ],
  "author": "trevo",
  "license": "ISC",
  "devDependencies": {
    "@agency/database": "workspace:*",
    "@changesets/cli": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
