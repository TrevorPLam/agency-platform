{
  "name": "agency-platform",
  "version": "1.0.0",
  "description": "Multi-client marketing agency monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
