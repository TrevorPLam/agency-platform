{
  "name": "agency-platform",
  "version": "1.0.0",
  "description": "Multi-client marketing agency monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:coverage": "turbo run test:coverage",
    "test:a11y": "turbo run test:a11y",
    "test:mutation": "pnpm exec stryker run",
    "type-check": "turbo run type-check",
    "tokens:build": "turbo run tokens:build",
    "scaffold": "tsx scripts/scaffold-client.ts",
    "db:generate-types": "pnpm run db:generate-types:local",
    "db:generate-types:local": "npx supabase gen types typescript --local --schema public > packages/database/src/types.ts",
    "db:generate-types:linked": "npx supabase gen types typescript --linked --schema public > packages/database/src/types.ts",
    "db:reset": "npx supabase db reset && pnpm run db:generate-types:local",
    "db:seed-user": "tsx scripts/create-test-user.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "version": "changeset version",
    "preinstall": "npx only-allow pnpm",
    "capture-knowledge": "tsx scripts/knowledge/capture.ts",
    "map-expertise": "tsx scripts/knowledge/expertise-map.ts",
    "search-knowledge": "tsx scripts/knowledge/search.ts",
    "classification": "tsx scripts/governance/classification-cli.ts",
    "manage-properties": "tsx scripts/governance/manage-properties.ts",
    "metadata-workflows": "tsx scripts/governance/metadata-workflows.ts",
    "risk-assessment": "tsx scripts/governance/risk-assessment.ts",
    "compliance-automation": "tsx scripts/governance/compliance-automation.ts"
  },
  "keywords": [
    "monorepo",
    "agency",
    "nextjs",
    "turborepo",
    "pnpm"
  ],
  "author": "trevo",
  "license": "ISC",
  "devDependencies": {
    "@agency/database": "workspace:*",
    "@changesets/cli": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "markdown-link-check": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
