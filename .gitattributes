# Handle line endings automatically for files detected as text
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout even if they've been edited or created
# with different line endings
*.bash text eol=lf
*.sh text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.rar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# GitHub Linguist overrides
vendor/** linguist-vendored
packages/**/dist/** linguist-generated
apps/**/dist/** linguist-generated
apps/**/.next/** linguist-generated
*.generated.* linguist-generated
docs/** linguist-documentation

# Merge strategy for lockfiles
package-lock.json merge=ours
yarn.lock merge=ours
pnpm-lock.yaml merge=ours

# Custom diff drivers
*.json diff=json
*.yaml diff=yaml
*.yml diff=yaml
